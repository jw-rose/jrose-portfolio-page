# API key for Resend, used in lib/resend.ts to send the contact form email (app/api/send-email/route.ts)
RESEND_API_KEY=

# Server-only: where contact form submissions are delivered. Never exposed to the client.
CONTACT_TO_EMAIL=

# Server-only, optional: Resend "from" address. Must be on a domain verified in Resend,
# otherwise falls back to Resend's onboarding@resend.dev test sender (limited deliverability).
CONTACT_FROM_EMAIL=

# Public contact email shown on the /contact page. Optional — defaults to josh@devjrose.com.
NEXT_PUBLIC_CONTACT_EMAIL=
